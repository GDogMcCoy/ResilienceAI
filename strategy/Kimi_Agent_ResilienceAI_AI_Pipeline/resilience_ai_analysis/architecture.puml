@startuml ResilienceAI System Architecture
!theme cerulean-outline

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam backgroundColor #FEFEFE

title ResilienceAI System Architecture v2.0

' ==================== DATA LAYER ====================
package "Data Layer" #E3F2FD {
    
    package "Federal APIs" #BBDEFB {
        [FEMA API\nDisaster Declarations] as FEMA #1976D2
        [Census ACS\nDemographics] as Census #1976D2
        [HIFLD\nInfrastructure] as HIFLD #1976D2
        [CMS\nNursing Homes] as CMS #1976D2
        [NOAA NWS\nWeather Alerts] as NOAA #1976D2
        [USDA NASS\nCrop Data] as USDA #1976D2
    }
    
    package "Climate & Geospatial" #BBDEFB {
        [RCC-ACIS\n4km Climate Grid] as ACIS #1976D2
        [USGS NWIS\nStreamflow] as USGS #1976D2
        [FEMA NRI\nHazard Risk] as NRI #1976D2
        [Google Earth Engine\nSatellite Imagery] as GEE #1976D2
        [US Drought Monitor\nWeekly D0-D4] as Drought #1976D2
    }
}

' ==================== PROCESSING LAYER ====================
package "Processing Layer" #E8F5E9 {
    
    [Data Pipeline\nAcquisition & Cleaning] as Pipeline #43A047
    [Feature Engineering\n66 Features] as Features #43A047
    [ML Models\nEnsemble Predictions] as Models #43A047
    [Predictive Models\nProphet/ARIMA] as Predictive #43A047
    
    database "Raw Data Cache" as RawCache #C8E6C9
    database "Processed Features\ncounty_features.csv" as Processed #C8E6C9
    database "Model Artifacts\n.pkl files" as ModelStore #C8E6C9
}

' ==================== AGENT LAYER ====================
package "Agent Layer (MCP)" #FFF3E0 {
    
    [Climate Agent\n11 Tools] as ClimateAgent #F57C00
    [Vulnerability Agent\n20 Tools] as VulnAgent #F57C00
    [Realtime Agent\n11 Tools] as RealtimeAgent #F57C00
    [Planning Agent\n14 Tools] as PlanningAgent #F57C00
    
    [Agent Orchestrator\nTool Routing] as Orchestrator #E65100
}

' ==================== INTERFACE LAYER ====================
package "Interface Layer" #F3E5F5 {
    
    [MCP Tools\n45+ Composable] as MCP #7B1FA2
    
    package "Streamlit Dashboard" #E1BEE7 {
        [Risk Overview] as Tab1 #9C27B0
        [Vulnerability Analysis] as Tab2 #9C27B0
        [Infrastructure Gaps] as Tab3 #9C27B0
        [Disaster History] as Tab4 #9C27B0
        [Maps & 3D Viz] as Tab5 #9C27B0
        [Predictive Analytics] as Tab6 #9C27B0
        [Real-time Alerts] as Tab7 #9C27B0
        [Export & Briefings] as Tab8 #9C27B0
    }
    
    package "Export APIs" #E1BEE7 {
        [FHIR R4 Export] as FHIR #9C27B0
        [GeoJSON Export] as GeoJSON #9C27B0
        [PDF Briefings] as PDF #9C27B0
        [PPTX Presentations] as PPTX #9C27B0
    }
}

' ==================== EXTERNAL SERVICES ====================
package "External Services" #FFEBEE {
    [Archia AI\nLLM Orchestration] as Archia #C62828
    [Webhook Notifications] as Webhooks #C62828
    [Email/SMS Gateway] as Notifications #C62828
}

' ==================== DATA FLOW ====================
' Data sources to pipeline
FEMA --> Pipeline
Census --> Pipeline
HIFLD --> Pipeline
CMS --> Pipeline
NOAA --> RealtimeAgent
USDA --> PlanningAgent
ACIS --> ClimateAgent
USGS --> ClimateAgent
NRI --> ClimateAgent
GEE --> ClimateAgent
Drought --> ClimateAgent

' Pipeline flow
Pipeline --> RawCache
RawCache --> Features
Features --> Processed
Processed --> Models
Models --> ModelStore
Processed --> VulnAgent

' Agent flow
ClimateAgent --> Orchestrator
VulnAgent --> Orchestrator
RealtimeAgent --> Orchestrator
PlanningAgent --> Orchestrator

' Orchestrator to interfaces
Orchestrator --> MCP
MCP --> Tab1
MCP --> Tab2
MCP --> Tab3
MCP --> Tab4
MCP --> Tab5
MCP --> Tab6
MCP --> Tab7
MCP --> Tab8
MCP --> FHIR
MCP --> GeoJSON
MCP --> PDF
MCP --> PPTX

' External services
Orchestrator --> Archia
RealtimeAgent --> Webhooks
RealtimeAgent --> Notifications

' Feedback loops
Tab1 ..> Orchestrator : User Queries
Archia ..> Orchestrator : LLM Responses

legend right
    |= Color |= Layer |
    | <#1976D2> | Data Sources |
    | <#43A047> | Processing |
    | <#F57C00> | Agents |
    | <#9C27B0> | Interface |
    | <#C62828> | External |
endlegend

@enduml
